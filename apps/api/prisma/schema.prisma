generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STOCK_MANAGER
  DESIGNER
}

enum ProductType {
  CUSTOM_WALLPAPER
  READY_WALLPAPER
  WALL_ART
  AESTHETIC_DECOR
  HOME_DECOR
  CUSTOM_DESIGN
}

enum InventoryTxnType {
  PURCHASE
  STOCK_IN
  STOCK_OUT
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_CANCELLED
  RETURN
  DAMAGE
  ADJUSTMENT
  TRANSFER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  googleId     String?  @unique
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses    Address[]
  orders       Order[]
  inventoryTxns InventoryTransaction[]
  auditLogs    AuditLog[]
  cart         Cart?
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  description     String
  type            ProductType
  sku             String       @unique
  price           Decimal      @db.Decimal(12, 2)
  discountPrice   Decimal?     @db.Decimal(12, 2)
  unit            String       @default("piece")
  pricePerSqFt    Decimal?     @db.Decimal(12, 2)
  material        String?
  finish          String?
  coverageSqFt    Decimal?     @db.Decimal(12, 2)
  images          String[]
  isCustomizable  Boolean      @default(false)
  isActive        Boolean      @default(true)
  categoryId      String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  variant     ProductVariant?
  inventory   Inventory?
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String    @unique
  sku       String    @unique
  name      String
  price     Decimal   @db.Decimal(12, 2)

  product   Product   @relation(fields: [productId], references: [id])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  totalQuantity     Int      @default(0)
  reservedQuantity  Int      @default(0)
  damagedQuantity   Int      @default(0)
  reorderLevel      Int      @default(10)
  warehouseLocation String   @default("Main Warehouse")
  unit              String   @default("piece")
  updatedAt         DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id])
  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id               String           @id @default(cuid())
  inventoryId      String
  quantity         Int
  type             InventoryTxnType
  previousQuantity Int
  newQuantity      Int
  referenceId      String?
  performedBy      String
  createdAt        DateTime         @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  user      User      @relation(fields: [performedBy], references: [id])

  @@index([inventoryId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int
  customization Json?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("India")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  addressId   String
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 2)
  tax         Decimal     @db.Decimal(12, 2)
  delivery    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)
  customization Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  status            PaymentStatus @default(PENDING)
  provider          String        @default("mock")
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
}
