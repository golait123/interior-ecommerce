# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Docker defaults shown)
DATABASE_URL=postgresql://interior:interior_dev@localhost:5432/interior_ecommerce?schema=public

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-chars

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Frontend URL (used for CORS)
WEB_URL=http://localhost:5173

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
# Create at: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── File Storage (optional S3-compatible) ────────────────────────────────────
# Leave blank to use URL-based images only
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# This goes in apps/web/.env (copy it there too)
VITE_API_URL=http://localhost:4000/api/v1

# ─── Cloudflare Tunnel (Production) ───────────────────────────────────────────
# Used by cloudflared service in docker-compose.prod.yml
CLOUDFLARE_TUNNEL_TOKEN=

